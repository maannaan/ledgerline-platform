# Copy to .env for local Compose. Never commit .env.
POSTGRES_USER=admin
POSTGRES_DB=ledgerline
POSTGRES_PASSWORD=ledgerline_local_only
DATABASE_URL=postgresql://admin:ledgerline_local_only@db:5432/ledgerline
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN
API_KEY_PEPPER=CHANGE_ME_PEPPER
SEED_API_KEYS=acme:CHANGE_ME_ACME_KEY,brightpath:CHANGE_ME_BRIGHTPATH_KEY,cobalt:CHANGE_ME_COBALT_KEY,delta:CHANGE_ME_DELTA_KEY
